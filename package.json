{
  "name": "ruta-builder",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Ruta Builder: project guidance, Solana opportunities and evidence-aware application drafts.",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts web/wallet.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "build": "vite build --config web/vite.config.ts",
    "build:public": "vite build --config web/vite.config.ts --mode public",
    "demo:public": "vite preview --config web/vite.config.ts --mode public --host 127.0.0.1 --port 4173 --strictPort",
    "web:dev": "vite --config web/vite.config.ts",
    "coach:demo": "tsx src/cli/coach.ts --demo",
    "coach:start": "tsx src/cli/coach.ts",
    "coach:smoke": "tsx src/cli/coach-smoke.ts",
    "demo": "tsx src/cli/demo.ts",
    "devnet:check": "tsx src/cli/devnet-check.ts",
    "devnet:sample": "tsx src/cli/devnet-sample.ts",
    "devnet:purchase": "tsx src/cli/devnet-purchase.ts",
    "report:rpc": "tsx src/cli/report-rpc.ts",
    "research:check": "tsx src/cli/research-check.ts"
  },
  "dependencies": {
    "@scure/base": "2.4.0",
    "@solana/kit": "5.5.1",
    "@solana/wallet-standard-chains": "1.1.2",
    "@solana/wallet-standard-features": "1.5.0",
    "@wallet-standard/app": "1.1.1",
    "@x402/core": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/svm": "2.28.0",
    "express": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
