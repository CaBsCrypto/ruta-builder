# Ruta Builder carga .env. Los CLI anteriores usan variables del entorno.
# npm run coach:demo no necesita clave ni wallet.
OPENAI_API_KEY=
COACH_PAY_TO=
COACH_PORT=4311
# Para Vite en 4310, definir COACH_PUBLIC_ORIGIN=http://127.0.0.1:4310
# COACH_DB_PATH=.cache/coach-devnet.sqlite
# PowerShell: $env:SOLANA_RPC_URL = 'https://api.devnet.solana.com'
SOLANA_RPC_URL=https://api.devnet.solana.com
FACILITATOR_URL=https://x402.org/facilitator
# La prueba genera wallets descartables en .cache/. No requiere claves de usuario.
